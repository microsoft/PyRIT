# Use Azure Artifacts feed as npm registry (proxies to npmjs.org).
# Required by Microsoft Secure Supply Chain policy:
#   CFS0001 — package.json must have a sibling .npmrc
#   CFS0003 — registry must be an Azure Artifacts feed
# Feed: ADO > AI Red Team > Artifacts > copyrit-npm
#
# NOTE: Docker builds and local dev override this via NPM_CONFIG_REGISTRY
# env var so auth is not required for routine installs.
registry=https://pkgs.dev.azure.com/atml/AI%20Red%20Team/_packaging/copyrit-npm/npm/registry/
