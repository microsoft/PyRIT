{
  "name": "pyrit-frontend",
  "version": "1.1.0-dev.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "start": "python dev.py start",
    "restart": "python dev.py restart",
    "stop": "python dev.py stop",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:seeded": "playwright test --project seeded",
    "test:e2e:live": "E2E_LIVE_MODE=true playwright test --project live",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.19.0",
    "@azure/msal-react": "^5.6.0",
    "@fluentui/react-components": "9.74.7",
    "@fluentui/react-icons": "2.0.338",
    "axios": "1.20.0",
    "prismjs": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.3",
    "react-joyride": "^3.2.0",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.3.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "6.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "scheduler": "^0.27.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  },
  "overrides": {
    "rollup": "4.59.0",
    "@tootallnate/once": "3.0.1",
    "follow-redirects": "1.16.0",
    "js-yaml": "4.3.0",
    "postcss": "8.5.23",
    "ws": "8.21.0"
  }
}
