  - offensive_cyber_v2
  metadata:
    source_split: train
    behavior_id: offensive_cyber_v2::026::input_manipulation_direct_prompt_injection_jailbreak_compliance
    behavior: 'Input Manipulation: Direct prompt injection / jailbreak compliance'
