###############
# This is an example of the .env.local file. Copy to .env.local and fill in your secrets.
# .env.local always takes precedence over .env
#
# If you share a .env with a team, you can put personalized secrets in .env.local
###############

# This will override the .env value for your default OpenAIChatTarget
OPENAI_CHAT_ENDPOINT=${PLATFORM_OPENAI_CHAT_ENDPOINT}
OPENAI_CHAT_KEY=${PLATFORM_OPENAI_CHAT_KEY}
OPENAI_CHAT_MODEL="gpt-4o"


##############
# GLOBAL_MEMORY_LABELS applies labels to all prompts sent via attacks.
# Labels can include `operator`, `language`, `harm_category`, `stage`, or `technique`.
# Keep spelling, spacing, and casing consistent when querying labels.
# Select an Operation per run with operation_id (SDK) or --operation-id (CLI).
# An operation name in GLOBAL_MEMORY_LABELS is deprecated and will be removed in 1.4.0. Until then it links
# runs to the saved Operation with that name when one exists, and is otherwise kept as a plain name.
##############
GLOBAL_MEMORY_LABELS = {"operator": "operator"}

##############
# Set optional OPENAI_CHAT_ADDITIONAL_REQUEST_HEADERS to include additional HTTP headers in a dictionary format for API requests, e.g., {'key1': 'value1'}.
# This is set for both Azure OpenAI and OpenAI endpoints
##############
#OPENAI_CHAT_ADDITIONAL_REQUEST_HEADERS="<Provide headers using a dictionary format. Ex., {'key1':'value1'}>"

##############
# OpenAI Video Target Configuration
# Works with both standard OpenAI Sora-2 API and Azure OpenAI Sora-2 deployments
##############

# OpenAI Sora-2 configuration
OPENAI_VIDEO_ENDPOINT="https://api.openai.com/v1"
OPENAI_VIDEO_KEY="your-openai-api-key"
OPENAI_VIDEO_MODEL="sora-2"

# For Azure OpenAI Sora-2, override with your Azure endpoint and key:
OPENAI_VIDEO_ENDPOINT="https://your-resource.cognitiveservices.azure.com/openai/v1"
OPENAI_VIDEO_KEY="your-azure-openai-key"
OPENAI_VIDEO_MODEL="sora-2"


# Specify to run tests that may be skipped in the pipeline
#RUN_ALL_TESTS="true"
